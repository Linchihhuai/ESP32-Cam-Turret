menu "Turret camera"

config CAM_ENABLE
    bool "Enable OV5640 camera and MJPEG stream"
    default n
    help
        Enable camera initialization and the MJPEG stream. Leave disabled to
        run the control webpage and servo without starting the camera.

config CAM_PIN_XCLK
    int "Camera XCLK GPIO"
    default 15

config CAM_PIN_PCLK
    int "Camera PCLK GPIO"
    default 13

config CAM_PIN_VSYNC
    int "Camera VSYNC GPIO"
    default 6

config CAM_PIN_HREF
    int "Camera HREF GPIO"
    default 7

config CAM_PIN_D0
    int "Camera D0 / Y2 GPIO"
    default 11

config CAM_PIN_D1
    int "Camera D1 / Y3 GPIO"
    default 9

config CAM_PIN_D2
    int "Camera D2 / Y4 GPIO"
    default 8

config CAM_PIN_D3
    int "Camera D3 / Y5 GPIO"
    default 10

config CAM_PIN_D4
    int "Camera D4 / Y6 GPIO"
    default 12

config CAM_PIN_D5
    int "Camera D5 / Y7 GPIO"
    default 18

config CAM_PIN_D6
    int "Camera D6 / Y8 GPIO"
    default 17

config CAM_PIN_D7
    int "Camera D7 / Y9 GPIO"
    default 16

config CAM_PIN_SIOD
    int "Camera SIOD / SDA GPIO"
    default 4

config CAM_PIN_SIOC
    int "Camera SIOC / SCL GPIO"
    default 5

config CAM_PIN_PWDN
    int "Camera PWDN GPIO (-1 if unused)"
    default -1

config CAM_PIN_RESET
    int "Camera RESET GPIO (-1 if unused)"
    default -1

endmenu
